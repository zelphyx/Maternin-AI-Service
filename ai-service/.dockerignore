# ──────────────────────────────────────────────────────────────────────
# MaternIn AI Service — Docker build excludes
# Files NOT shipped to the Space image (model artifacts + data fetched
# from HF Hub at runtime instead).
# ──────────────────────────────────────────────────────────────────────

# Python / build artifacts
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# macOS / OS noise
.DS_Store
Thumbs.db

# VCS / local config
.git/
.gitignore
.gitattributes

# Secrets (set via HF Space Secrets instead)
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Training scripts (not used at runtime)
app/training/
scripts/

# Datasets (training data, not deployed)
datasets/

# Test suite (not part of runtime image)
tests/

# Documentation (not part of runtime image)
docs/

# Model artifacts (~125 MB, fetched from HF Hub at runtime)
app/model_artifacts/

# IDE / editor configs
.idea/
.vscode/
*.swp
