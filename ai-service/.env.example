# MaternIn AI Service — Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# JANGAN commit file .env ke git — hanya .env.example ini yang boleh di-commit.

# --- API Keys ---
GROQ_API_KEY=
FONNTE_API_KEY=

# --- Inter-Service Auth ---
# Shared secret antara AI Service & NestJS (min 32 karakter)
INTERNAL_SERVICE_TOKEN=

# --- NestJS Backend URL ---
# Base URL endpoint internal NestJS (tanpa trailing slash)
NESTJS_INTERNAL_BASE_URL=http://localhost:3000

# --- Model Artifacts ---
MODEL_ARTIFACT_DIR=./app/model_artifacts

# --- Logging ---
LOG_LEVEL=info
